    <dimen name="dock_bottom">104dp</dimen>
    <dimen name="dock_item_h">72dp</dimen>

    <dimen name="sky_height">320dp</dimen>
    <dimen name="column_gap">20dp</dimen>

    <dimen name="title_text">30sp</dimen>
