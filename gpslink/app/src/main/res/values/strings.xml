    <string name="rate_sender_label">采样频率（发送端 GPS 采集）</string>
    <string name="rate_receiver_label">注入频率（接收端写入系统位置）</string>
    <string name="rate_hint">采样：1 Hz 和真机 GPS 一致；部分机型硬件只支持 1 Hz，实际以上方「刷新」为准。注入：高于采样时，接收端会按 speed / bearing 在两次帧之间外推补点，让蓝点连续移动。</string>

    <string name="sat_title">卫星信号</string>

    <string name="detail_title">定位数据</string>
    <string name="d_latlon">坐标</string>
    <string name="d_accuracy">精度</string>
    <string name="d_altitude">高度</string>
    <string name="d_speed">速度</string>
    <string name="d_bearing">运动方向</string>
    <string name="d_age">源点年龄</string>
    <string name="verify_title">定位校验</string>
    <string name="verify_hint">「系统回读」是本机从系统拿到的当前定位，也就是高德 / 百度 / Google 地图拿到的同一个值。它和注入值一致且 mock=true，说明确实在用发送端的数据。最直观的验证：拿着 A 走开 20 米，B 的坐标应该跟着变，而 B 自己没动。</string>
    <string name="log_title">运行日志</string>

    <string name="tip">用法：A 手机点「开始共享」，B 手机点「开始接收」。两台设备需在同一 Wi-Fi 下，房间码一致。B 端授权后，高德 / 百度 / Google 地图会直接把 A 的位置当作自己的位置。</string>
