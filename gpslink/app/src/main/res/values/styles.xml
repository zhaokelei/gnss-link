<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 卡片：与 Web 版一致的厚度与圆角，靠 @color 自动适配深色 -->
    <style name="GnssCard">
        <!-- 这两个尺寸必须写在 style 里：使用处只写 style="@style/GnssCard"，
             缺了会在 inflate 阶段直接抛 "You must supply a layout_width" -->
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/card_pad</item>
        <item name="android:layout_marginBottom">@dimen/card_gap</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="GnssPageTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/title_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GnssPageSub">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/body_text</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">18dp</item>
    </style>

    <style name="GnssCardTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GnssLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/body_text</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="GnssHint">
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/caption_text</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="GnssValue">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GnssBtn">
        <item name="android:background">@drawable/bg_btn</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="GnssBtnPrimary" parent="GnssBtn">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/text_on_brand</item>
    </style>

    <style name="GnssBtnDanger" parent="GnssBtn">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- 服务运行中的「开始」按钮：换成绿色实心并把文案改为「共享中」，
         避免只把按钮置灰导致用户以为界面卡住 -->
    <style name="GnssBtnRunning" parent="GnssBtn">
        <item name="android:background">@drawable/bg_btn_running</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GnssField">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="GnssDockItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/dock_item_h</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="GnssDockLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>

    <style name="GnssSectionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- 分段控件：去掉系统 radio 圆圈，选中态自绘。
         高度必须用 match_parent：父 RadioGroup 有固定高度和 padding，
         子项再写死高度会溢出容器，把圆角边框整圈盖掉。 -->
    <style name="GnssSeg">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/bg_seg_item</item>
        <item name="android:textColor">@color/seg_text</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="GnssKvRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="GnssKvKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="GnssKvValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">end</item>
    </style>
</resources>
