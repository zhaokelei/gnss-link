<?xml version="1.0" encoding="utf-8"?>
<!--
  授权页 · 横屏双栏。
  左栏：授权状态与操作按钮；右栏：后台保活、命令行授权。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/page_pad"
    android:paddingTop="16dp"
    android:paddingRight="@dimen/page_pad"
    android:paddingBottom="@dimen/dock_bottom">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/GnssPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设备授权" />

            <TextView
                style="@style/GnssPageSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="模拟位置、后台保活，以及开不了开发者选项时的命令行方案" />

            <LinearLayout style="@style/GnssCard">

                <LinearLayout style="@style/GnssSectionRow">

                    <TextView
                        style="@style/GnssCardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="授权状态" />

                    <TextView
                        android:id="@+id/auth_tier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_idle"
                        android:paddingLeft="10dp"
                        android:paddingTop="4dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="4dp"
                        android:text="检测中"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/caption_text" />
                </LinearLayout>

                <LinearLayout style="@style/GnssKvRow">
                    <TextView style="@style/GnssKvKey" android:text="系统版本" />
                    <TextView android:id="@+id/auth_android" style="@style/GnssKvValue" android:text="检测中" />
                </LinearLayout>

                <LinearLayout style="@style/GnssKvRow">
                    <TextView style="@style/GnssKvKey" android:text="定位权限" />
                    <TextView android:id="@+id/check_location" style="@style/GnssKvValue" android:text="待检查" />
                </LinearLayout>

                <LinearLayout style="@style/GnssKvRow">
                    <TextView style="@style/GnssKvKey" android:text="模拟位置" />
                    <TextView android:id="@+id/check_mock" style="@style/GnssKvValue" android:text="待检查" />
                </LinearLayout>

                <LinearLayout style="@style/GnssKvRow">
                    <TextView style="@style/GnssKvKey" android:text="后台定位" />
                    <TextView android:id="@+id/check_background" style="@style/GnssKvValue" android:text="待检查" />
                </LinearLayout>

                <LinearLayout style="@style/GnssKvRow">
                    <TextView style="@style/GnssKvKey" android:text="后台运行" />
                    <TextView android:id="@+id/check_battery" style="@style/GnssKvValue" android:text="待检查" />
                </LinearLayout>

                <TextView
                    android:id="@+id/auth_steps"
                    style="@style/GnssHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="正在检查授权方式…" />

                <TextView
                    android:id="@+id/auth_why"
                    style="@style/GnssHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/warn"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_permissions"
                        style="@style/GnssBtn"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_weight="1"
                        android:text="允许定位权限" />

                    <Button
                        android:id="@+id/btn_mock"
                        style="@style/GnssBtnPrimary"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/touch_min"
                        android:layout_marginLeft="10dp"
                        android:layout_weight="1"
                        android:text="选择模拟位置应用" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_background"
                    style="@style/GnssBtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginTop="10dp"
                    android:text="允许后台定位" />

                <Button
                    android:id="@+id/btn_battery"
                    style="@style/GnssBtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginTop="10dp"
                    android:text="关闭电池优化" />

                <Button
                    android:id="@+id/btn_recheck"
                    style="@style/GnssBtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginTop="10dp"
                    android:text="重新检查状态" />
            </LinearLayout>

            <LinearLayout style="@style/GnssCard">

                <TextView
                    style="@style/GnssCardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="注入自检" />

                <TextView
                    style="@style/GnssHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="点一个地点即开始持续注入，按钮变为「注入中」；此时的接收会暂停，发送端数据不参与注入。再点一次取消注入，恢复接收共享端坐标。" />

                <LinearLayout
                    android:id="@+id/preset_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/preset_state"
                    style="@style/GnssHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/brand" />

                <TextView
                    android:id="@+id/preset_verify_hint"
                    style="@style/GnssHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="如何判断模拟位置是否成功：\n1. 用导航软件看蓝点，与注入坐标一致即为成功；\n2. 也可对照「连接」页显示的坐标，两者相差应在几米内；\n3. 若蓝点仍在你自己所在位置，说明本机 GPS 还在生效，需要确认「选择模拟位置信息应用」已选中本应用。" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/column_gap"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout style="@style/GnssCard">

                <LinearLayout style="@style/GnssSectionRow">

                    <TextView
                        style="@style/GnssCardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="后台保活" />

                    <TextView
                        android:id="@+id/keepalive_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_idle"
                        android:paddingLeft="10dp"
                        android:paddingTop="4dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="4dp"
                        android:text="未开启"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/caption_text" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="悬浮窗 + 常驻通知"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/keepalive_hint"
                            style="@style/GnssHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="开启后退到后台，角落出现一枚可拖动的小标签，并保持通知不被清理。" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/keepalive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/touch_min"
                        android:minWidth="@dimen/touch_min"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_overlay"
                    style="@style/GnssBtn"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_min"
                    android:layout_marginTop="12dp"
                    android:text="授予悬浮窗权限"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout style="@style/GnssCard">

                <LinearLayout style="@style/GnssSectionRow">

                    <TextView
                        style="@style/GnssCardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="命令行授权" />

                    <Button
                        android:id="@+id/btn_copy_adb"
                        style="@style/GnssBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minHeight="40dp"
                        android:text="复制命令"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/adb_note"
                    style="@style/GnssHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="正在按系统版本生成对应命令…" />

                <TextView
                    android:id="@+id/adb_cmd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_field"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:text="adb shell appops set top.wxip.gpslink android:mock_location allow"
                    android:textColor="@color/log_text"
                    android:textSize="@dimen/caption_text" />

                <TextView
                    style="@style/GnssHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="验证是否生效：" />

                <TextView
                    android:id="@+id/adb_check"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_field"
                    android:fontFamily="monospace"
                    android:padding="12dp"
                    android:text="adb shell appops get top.wxip.gpslink android:mock_location"
                    android:textColor="@color/log_text"
                    android:textSize="@dimen/caption_text" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
