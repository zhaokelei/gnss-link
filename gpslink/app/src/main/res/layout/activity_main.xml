<?xml version="1.0" encoding="utf-8"?>
<!-- 原生主界面：五页容器 + 悬浮底部导航。全部控件自绘，不依赖浏览器默认样式。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include android:id="@+id/page_link" layout="@layout/page_link" />

        <include
            android:id="@+id/page_sat"
            layout="@layout/page_sat"
            android:visibility="gone" />

        <include
            android:id="@+id/page_access"
            layout="@layout/page_access"
            android:visibility="gone" />

        <include
            android:id="@+id/page_settings"
            layout="@layout/page_settings"
            android:visibility="gone" />

        <include
            android:id="@+id/page_about"
            layout="@layout/page_about"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dock"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/dock_link"
            style="@style/GnssDockItem">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:contentDescription="@string/nav_link"
                app:srcCompat="@drawable/ic_nav_link"
                app:tint="@color/nav_text" />

            <TextView
                style="@style/GnssDockLabel"
                android:duplicateParentState="true"
                android:text="@string/nav_link"
                android:textColor="@color/nav_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dock_sat"
            style="@style/GnssDockItem">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:contentDescription="@string/nav_sat"
                app:srcCompat="@drawable/ic_nav_sat"
                app:tint="@color/nav_text" />

            <TextView
                style="@style/GnssDockLabel"
                android:duplicateParentState="true"
                android:text="@string/nav_sat"
                android:textColor="@color/nav_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dock_access"
            style="@style/GnssDockItem">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:contentDescription="@string/nav_access"
                app:srcCompat="@drawable/ic_nav_access"
                app:tint="@color/nav_text" />

            <TextView
                style="@style/GnssDockLabel"
                android:duplicateParentState="true"
                android:text="@string/nav_access"
                android:textColor="@color/nav_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dock_settings"
            style="@style/GnssDockItem">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:contentDescription="@string/nav_settings"
                app:srcCompat="@drawable/ic_nav_settings"
                app:tint="@color/nav_text" />

            <TextView
                style="@style/GnssDockLabel"
                android:duplicateParentState="true"
                android:text="@string/nav_settings"
                android:textColor="@color/nav_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dock_about"
            style="@style/GnssDockItem">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:duplicateParentState="true"
                android:contentDescription="@string/nav_about"
                app:srcCompat="@drawable/ic_nav_about"
                app:tint="@color/nav_text" />

            <TextView
                style="@style/GnssDockLabel"
                android:duplicateParentState="true"
                android:text="@string/nav_about"
                android:textColor="@color/nav_text" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
